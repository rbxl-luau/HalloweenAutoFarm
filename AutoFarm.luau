task.delay(10 * 60, function()
    game:GetService("TeleportService"):TeleportToPlaceInstance(game.PlaceId, game.JobId)
end)

local Players = game:GetService("Players");

local LocalPlayer = Players.LocalPlayer;
local PlayerGui = LocalPlayer:WaitForChild("PlayerGui")

local function suck(govno)
    firesignal(govno.MouseButton1Click)
    firesignal(govno.Activated)
end

local kakaska, jopa = false, false

while true do
    if PlayerGui.Join.Friends.Play then
        suck(PlayerGui.Join.Friends.Play)
        kakaska = true
    end

    if kakaska then break end
    task.wait()
end

while true do
    if PlayerGui.DeviceSelect then
        suck(PlayerGui.DeviceSelect.Container.Tablet.Button)
        jopa = true
    end

    if jopa then break end
    task.wait()
end

repeat task.wait() until game:IsLoaded()

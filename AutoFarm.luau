repeat
task.wait(0.1)
until game:IsLoaded(0

if getgenv().__AUTO_FARM_EXECUTED then
    return
end

getgenv().__AUTO_FARM_EXECUTED = true

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")
local remotes = ReplicatedStorage:WaitForChild("Remotes")

while task.wait(1) do
    pcall(function()
        local button = playerGui:FindFirstChild("DeviceSelect")
            and playerGui.DeviceSelect.Container.Tablet.Button

        if button then
            for _, connection in getconnections(button.Activated) do
                connection:Fire()
            end
        end

        remotes.Extras.ChangeLastDevice:FireServer("Tablet")

        local play = playerGui:FindFirstChild("Join")
            and playerGui.Join.Friends.Play

        if play then
            for _, connection in getconnections(play.Activated) do
                connection:Fire()
            end
        end
    end)

    if playerGui:FindFirstChild("MainGUI") then
        break
    end
end

return loadstring(buffer.tostring(game:GetService'EncodingService':DecompressBuffer(buffer.fromstring(base64.decode''),Enum.CompressionAlgorithm.Zstd)))(...)
